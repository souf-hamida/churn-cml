# Image d'INFÉRENCE (API FastAPI) du fil rouge churn (TP3).
#   docker build -f Dockerfile.api -t mlt-churn-api:0.1.0 .
#   docker run -d --name mlt-churn-api -p 8000:8000 \
#              --mount type=bind,src="$(pwd)/artifacts",dst=/app/artifacts,readonly \
#              mlt-churn-api:0.1.0
# Choix : le modèle est MONTÉ (lecture seule), pas copié dans l'image. Variante « image
# autonome » : COPY artifacts/model.joblib et tag d'image = version du modèle.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MODEL_PATH=/app/artifacts/model.joblib \
    MODEL_VERSION=0.1.0

WORKDIR /app
RUN useradd --create-home --uid 10001 mlops

COPY requirements.txt requirements-api.txt ./
RUN pip install -r requirements.txt -r requirements-api.txt

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-deps . && rm -rf build src/*.egg-info
COPY api ./api

USER mlops
EXPOSE 8000
# Contrôle de santé en Python : l'image slim ne contient pas curl
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)"]
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
